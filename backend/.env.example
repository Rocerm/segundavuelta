# Copia este archivo como .env y pon los datos de TU MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pon_aqui_tu_contrasena
DB_NAME=dbsegundavuelta
PORT=4600
# 0.0.0.0 = otras computadoras de la red pueden conectarse (necesario si el frontend corre en otra compu).
HOST=0.0.0.0
# Qué frontends pueden hablar con esta API. * = cualquiera (lo más fácil en la escuela).
# Para limitarlo:  CORS_ORIGINS=http://192.168.20.5:5500   (varios separados por coma)
CORS_ORIGINS=*
# Solo desarrollo: si pones si, este mismo servidor también entrega la carpeta ../frontend (todo en un puerto).
SERVIR_FRONT=no
# Con este secreto se FIRMAN los JWT. En un servidor real va un valor largo, aleatorio y secreto.
# Si alguien lo conoce puede fabricar tokens falsos. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo
